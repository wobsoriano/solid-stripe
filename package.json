{
  "name": "solid-stripe",
  "version": "1.0.0",
  "private": false,
  "description": "Solid components for Stripe.js and Stripe Elements",
  "keywords": [
    "elements",
    "solid",
    "stripe"
  ],
  "homepage": "https://github.com/wobsoriano/solid-stripe#readme",
  "license": "MIT",
  "author": "Robert Soriano <sorianorobertc@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobsoriano/solid-stripe.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./checkout": {
      "types": "./dist/checkout.d.ts",
      "solid": "./dist/checkout.jsx",
      "default": "./dist/checkout.js"
    }
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test",
    "prepublishOnly": "vp pack",
    "release": "vp pack && changeset publish",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@alenaksu/json-viewer": "^2.0.1",
    "@changesets/cli": "^2.27.8",
    "@solidjs/testing-library": "^0.8.10",
    "@stripe/stripe-js": "^10.2.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "solid-js": "catalog:",
    "typescript": "^5.4.5",
    "unplugin-solid": "^2.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@stripe/stripe-js": ">=10.0.0 <11.0.0",
    "solid-js": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9"
}
